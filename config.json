  "_geoip_comment": "Generate traffic to IPs in embargoed/sanctioned countries so firewall GeoIP (destination-country) policies match. Per-country IPv4 CIDRs pulled from ipdeny.com aggregated zones. ips_per_country = random IPs hit per country per pass. Add {code,name,domain} entries to 'domains' for known in-country sites (cleaner signal). Run with --geo or --geo-only.",
  "geoip": {
    "enabled": true,
    "cidr_url_template": "https://www.ipdeny.com/ipblocks/data/aggregated/{cc}-aggregated.zone",
    "ips_per_country": 2,
    "poll_interval_sec": 3600,
    "countries": [
      {"code": "cu", "name": "Cuba"},
      {"code": "ir", "name": "Iran"},
      {"code": "sy", "name": "Syria"},
      {"code": "kp", "name": "North Korea"},
      {"code": "ru", "name": "Russia"},
      {"code": "by", "name": "Belarus"},
      {"code": "ve", "name": "Venezuela"},
      {"code": "cn", "name": "China"},
      {"code": "mm", "name": "Myanmar"},
      {"code": "af", "name": "Afghanistan"},
      {"code": "iq", "name": "Iraq"},
      {"code": "ly", "name": "Libya"},
      {"code": "sd", "name": "Sudan"},
      {"code": "ss", "name": "South Sudan"},
      {"code": "so", "name": "Somalia"},
      {"code": "ye", "name": "Yemen"},
      {"code": "cd", "name": "DR Congo"},
      {"code": "cf", "name": "Central African Rep"},
      {"code": "er", "name": "Eritrea"},
      {"code": "lb", "name": "Lebanon"},
      {"code": "ml", "name": "Mali"},
      {"code": "ni", "name": "Nicaragua"},
      {"code": "zw", "name": "Zimbabwe"},
      {"code": "et", "name": "Ethiopia"}
    ],
    "domains": []
  },

  "_app_control_comment": "Generate real application-protocol traffic for Application Control / App-ID (DPI, not URLs): BitTorrent (tracker announce + DHT), Proxy (HTTP CONNECT + absolute-URI), and Tor (real circuit via torpy). Client-side block detection is best-effort; the firewall App Control / App-ID log is authoritative. Run with --apps or --apps-only.",
  "app_control": {
    "enabled": true,
    "bittorrent": {
      "trackers": [
        "http://example.com/announce",
        "http://tracker.opentrackr.org:1337/announce"
      ],
      "dht_nodes": [
        ["router.bittorrent.com", 6881],
        ["dht.transmissionbt.com", 6881],
        ["router.utorrent.com", 6881]
      ]
    },
    "proxy": {
      "host": "example.com",
      "port": 80,
      "connect_targets": ["www.google.com:443"],
      "absolute_uris": ["http://www.google.com/"]
    },
    "tor": {
      "enabled": true,
      "target_host": "example.com",
      "target_port": 80,
      "timeout": 90
    }
  },

  "_ips_comment": "Validate firewall IPS by carrying well-known signature patterns (Shellshock, Log4Shell, SQLi, XSS, traversal, scanner UAs, GPL id-check) to a neutral sink. IMPORTANT: use a target with NO upstream WAF so blocks are unambiguously the firewall - http://example.com (IANA test domain, no WAF) or best of all a plain web server inside your lab. Avoid Cloudflare-fronted echo services, which block these themselves. Use http:// so IPS can inspect without SSL deep inspection. Run with --ips or --ips-only.",
  "ips": {
    "enabled": true,
    "target_url": "http://example.com/",
    "target_post_url": "http://example.com/"
  },

  "_file_filter_comment": "Exercise firewall File Filter by uploading locally-generated files (correct magic bytes, harmless content) to upload_url AND downloading real harmless files. Types align with a typical block-exec / block-image / monitor-docs policy. Run with --files or --files-only.",
  "file_filter": {
    "enabled": true,
    "upload_url": "https://postman-echo.com/post",
    "generate_types": [
      "exe", "dll", "net", "scr", "msi", "elf", "mach-o", "bat", "hta", "jnlp",
      "iso", "dmg", "torrent",
      "zip", "zip_encrypted", "7z", "rar", "pdf", "docx", "xlsx", "doc"
    ],
    "download_urls": [
      "http://ipv4.download.thinkbroadband.com/5MB.zip",
      "https://the.earth.li/~sgtatham/putty/latest/w64/putty.exe"
    ]
  },

  "_threat_feeds_comment": "Pull the same external threat-feed lists the firewall uses and mix a small random assortment into traffic to prove the feeds are matching. Real malicious indicators - feed targets are never fully downloaded or saved. mix_rate 0.025 = ~2.5% of connections. Set enabled=false to skip.",
  "threat_feeds": {
    "enabled": true,
    "mix_rate": 0.025,
    "poll_interval_sec": 600,
    "max_per_pass": 40,
    "fetch_timeout_sec": 20,
    "feeds": {
      "urls": "https://raw.githubusercontent.com/bbartik/threat-feed-examples/refs/heads/main/bad-urls.txt",
      "ips": "https://raw.githubusercontent.com/bbartik/threat-feed-examples/refs/heads/main/bad-ips.txt",
      "domains": "https://raw.githubusercontent.com/bbartik/threat-feed-examples/refs/heads/main/bad-domains.txt"
    }
  },

